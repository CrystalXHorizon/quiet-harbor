# Keep real values on the backend host only. Never put API keys in GitHub Pages.
PORT=4173
HOST=127.0.0.1
# Exact HTTPS chat-completions endpoint for your chosen provider.
AI_ENDPOINT=https://api.deepseek.com/chat/completions
AI_API_KEY=
AI_MODEL=deepseek-flash
# Optional separate safety model (otherwise AI_MODEL).
AI_SAFETY_MODEL=
# Generate a random 32+ character secret for access to your personal backend.
APP_ACCESS_TOKEN=
# Comma-separated exact frontend origins. No trailing slash or repository path.
ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
