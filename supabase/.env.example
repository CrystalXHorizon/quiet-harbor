# Copy to supabase/.env.local (Git-ignored), then fill values locally.
# Never commit the populated file or paste keys into chat.
ALLOWED_ORIGINS=https://crystalxhorizon.github.io,http://127.0.0.1:4177
# Standard Base64 of exactly 32 cryptographically random bytes.
AI_ENCRYPTION_KEY=
# Optional trusted public provider hostnames, comma separated, no wildcard.
AI_ALLOWED_HOSTS=
# Email MFA uses the Resend HTTP API independently of Supabase Auth SMTP.
# Sending-only API key restricted to your verified sending domain.
MFA_RESEND_API_KEY=
MFA_EMAIL_FROM=noreply@auth.sureando.cn
# A SEPARATE standard Base64 secret containing 32 random bytes.
MFA_EMAIL_SECRET=
